{
  "name": "hajimari-kara",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "volta": {
    "node": "22.13.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && find dist -name .dev.vars -delete && find dist -name .env -delete",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply hajimari-kara --local",
    "db:migrate:remote": "wrangler d1 migrations apply hajimari-kara --remote"
  },
  "dependencies": {
    "hono": "^4.13.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.11",
    "@cloudflare/workers-types": "^5.20260917.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.133.0"
  }
}
